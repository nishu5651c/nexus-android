rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // User profile images under 'user_photos/{uid}/{filename}'
    match /user_photos/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Files shared in conversations
    match /files/{fileId}/{allPaths=**} {
      allow read: if false; // enforce via signed urls or security rules in next phase
      allow write: if request.auth != null;
    }

    // Deny by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
